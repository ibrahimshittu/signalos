# SignalOS uses Supabase from the first local run through production.
SIGNALOS_ENVIRONMENT=development
UVICORN_PORT=8001
SIGNALOS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SIGNALOS_DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:5432/postgres

# Internal admin routes only. Generate a random value of at least 32 characters.
# Example: openssl rand -hex 32
SIGNALOS_API_KEY="" # Set locally

# Encrypts the single Bybit credential used for portfolio sync and user-confirmed orders.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIGNALOS_CREDENTIAL_ENCRYPTION_KEY="" # Set locally
SIGNALOS_CREDENTIAL_PREVIOUS_ENCRYPTION_KEYS=[]

# Expo enhanced push security access token from expo.dev notifications settings.
SIGNALOS_EXPO_ACCESS_TOKEN="" # Set locally
SIGNALOS_EXPO_RECEIPT_INTERVAL_SECONDS=900

# AI analysis. Required for live model analysis; deterministic APIs and scans do not need it.
SIGNALOS_OPENROUTER_API_KEY="" # Set locally
SIGNALOS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SIGNALOS_PRODUCER_MODEL=openai/gpt-5.2
SIGNALOS_VERIFIER_MODEL=anthropic/claude-opus-4-6

# Optional observability and background research. Leave disabled for the first run.
SIGNALOS_LOGFIRE_SEND=false
SIGNALOS_TEMPORAL_ENABLED=false
SIGNALOS_TEMPORAL_ADDRESS=localhost:7233
SIGNALOS_TEMPORAL_NAMESPACE=default
SIGNALOS_API_BASE_URL=http://localhost:8001

# Bybit and market scanning.
SIGNALOS_BYBIT_MAINNET_BASE_URL=https://api.bybit.com
SIGNALOS_BYBIT_TESTNET_BASE_URL=https://api-testnet.bybit.com
SIGNALOS_BYBIT_RECV_WINDOW_MS=5000
SIGNALOS_BYBIT_TIMEOUT_SECONDS=10
SIGNALOS_EXECUTION_RECONCILIATION_INTERVAL_SECONDS=5
SIGNALOS_EXECUTION_STEP_UP_MAX_AGE_SECONDS=300
SIGNALOS_MARKET_SCAN_INTERVAL_SECONDS=60
SIGNALOS_MARKET_ANALYSIS_INTERVAL_SECONDS=300
SIGNALOS_MARKET_ANALYSIS_MAX_CANDIDATES=5
SIGNALOS_MARKET_ANALYSIS_CANDLE_INTERVAL_MINUTES=15
SIGNALOS_MARKET_ANALYSIS_CANDLE_LIMIT=200
SIGNALOS_MARKET_DATA_MAX_AGE_SECONDS=30
SIGNALOS_INSTRUMENT_REFRESH_SECONDS=21600
